timestep 0.01

run 1000000

fix 41 all efield -1.5 0.0 0.0  # Apply electric field with strength 1.0 in the x-direction

timestep 0.002

unfix 21
unfix 31


unfix xwalls

         # Integrate using NVE (constant Energy)
fix 22 all nve           # Integrate using NVE (constant Energy)

