###############################################
# LAMMPS script for a polymer
###############################################

###
# Box and units  (use LJ units and periodic boundaries)
###

# Initialize simulation
units lj                # Use Lennard-Jones units
dimension 3             # 3D simulation
boundary p p p        # Periodic boundaries in all directions
atom_style full       # Simple atomic style, no bonds or charges
neighbor 5 bin

###
# Pair interactions require lists of neighbours to be calculated
###
neighbor 5 bin
neigh_modify every 1 delay 0 check yes 

variable bsize equal 1000
variable rsize equal 1
##############################  gel #########################
variable bsizeh equal 2.5*${bsize}+${rsize}
variable bsizel equal 2.5*${bsize}-${rsize}
variable bsizeyzh equal ${bsize}/2+${rsize}
variable bsizeyzl equal ${bsize}/2-${rsize}
region box block -20 10020 0 ${bsize} 0 ${bsize}
create_box 35 box bond/types 2 angle/types 1 extra/bond/per/atom 20 extra/special/per/atom 20 extra/angle/per/atom 20 # Create box for 2 atom types

#set type * mass 1

# Override if passed from the command l

variable seed equal 8293

#read_data DNA_coordinates_test.data extra/bond/per/atom 2 extra/special/per/atom 10 extra/angle/per/atom 2
read_data DNA_coordinates_23_small.data extra/bond/per/atom 2 extra/special/per/atom 10 extra/angle/per/atom 2 add append shift 500 500 500
#region region_DNA block ${bsizel} ${bsizeh} ${bsizeyzl} ${bsizeyzh} ${bsizeyzl} ${bsizeyzh}

#molecule DNA_28 DNA_results.templates_3_12400000_28
#create_atoms 0 random 1 123475 region_DNA mol DNA_28 126354 maxtry 3000 overlap 2
#molecule DNA_29 DNA_results.templates_3_12400000_29
#create_atoms 0 random 1 123475 region_DNA mol DNA_29 126354 maxtry 3000 overlap 2
mass * 1

restart 100000 polymer.restart_control_3
bond_style hybrid harmonic fene
special_bonds fene #<=== I M P O R T A N T prevents LJ from being counted twice
bond_coeff   1 fene  30   3   1.0   2.0  # Adjust sigma to 2.0 in FEN
bond_coeff 2 harmonic 30 2  # Bond type 2: Harmonic bond (DNA-protein crosslink)
## Between non-bonded atoms
pair_style   lj/cut 2.24492305924378     # The cutoff should be ~2.2449 when sigma = 2.0
pair_modify shift yes        # option to ensure energy is calculated corectly
#  pair_coeff for LJ, specify 4:
#    * atom type interacting with
#    * atom type
#    * energy
#    * mean diameter of the two atom types
#    * cutoff
pair_coeff   * * 2 2.4 2.64492305924378 # Adjust sigma to 2.0 in LJ
#pair_coeff 1 1 1 2 3.24494

print "pair!"


## angles
angle_style  cosine
angle_coeff   1  25.0
# this choice gives a polymer with the same persistence length as DNA

print "angle!"

# Immediately after switching to FENE and LJ
timestep 0.001

set type * charge -1

print "set!"

dump myDump all custom 5000 dump.control_3_small_23_200_8293_2000000 id type mol x y z ix iy iz
# every 1000 time steps, each atom's id, type, x,y,z coords and x,y,z image flages are output.
# image flags count how many times each atom has moved through a periodic boundary

dump force_dump all custom 5000 forces.dump_control_3_small_23_200_8293_2000000 id type x y z fx fy fz vx vy vz

compute myPairs all pair/local dist fx fy fz

compute bond_name all property/local batom1 batom2 btype
dump bond_name_dump all local 5000 dump.bond_name_control_3_small_23_200_8293_2000000 index c_bond_name[3] c_bond_name[1] c_bond_name[2] 

compute bond_local all bond/local dist engpot fx fy fz 
dump bond_dump all local 5000 dump.bond_local_control_3_small_23_200_8293_2000000 index c_bond_local[1] c_bond_local[2] c_bond_local[3] c_bond_local[4] c_bond_local[5] 

compute angle_name all property/local aatom1 aatom2 aatom3 atype
dump angle_name_dump all local 5000 dump.angle_name_control_3_small_23_200_8293_2000000 index c_angle_name[4] c_angle_name[1] c_angle_name[2] c_angle_name[3]

compute angle_local all angle/local eng theta
dump angle_dump all local 5000 dump.angle_local_control_3_small_23_200_8293_2000000 index c_angle_local[1] c_angle_local[2] 


compute pairForce all pair/local dist dx dy dz fx fy fz
compute bondForce all bond/local fx fy fz
dump force_dump1 all local 5000 forces.dump_pair c_pairForce[1] c_pairForce[2] c_pairForce[3] c_pairForce[4] c_pairForce[5] c_pairForce[6] c_pairForce[7]
dump force_dump2 all local 5000 forces.dump_bond c_bondForce[1] c_bondForce[2] c_bondForce[3]

# Monitor forces in the log file
#compute force all property/atom fx fy fz
#thermo_style custom step temp pe c_force[1] c_force[2] c_force[3]

fix xwalls all indent 10 plane x 3000 hi
fix xlowalls all indent 10 plane x 0 lo

#fix ywalls all indent 10 plane y ${bsize} hi
#fix ylowalls all indent 10 plane y 0 lo

#fix zwalls all indent 10 plane z ${bsize} hi
#fix zlowalls all indent 10 plane z 0 lo

thermo 10000


# Time integration (nve, as there's no thermostat needed)
fix 21 all nve           # Integrate using NVE (constant Energy)

fix 31 all langevin 1 1 1 8293

write_dump all atom before_run_dump.atom
write_dump all custom before_run_dump.mol id type mol x y z ix iy iz 

print "write!"

#run 0
       # Run the simulation for 1000 timesteps
