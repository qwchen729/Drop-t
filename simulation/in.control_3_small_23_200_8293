# Define a loop that repeats the region selection and grouping process every 1000 timesteps
variable step equal 5000
variable n loop 2000  # Adjust this to control how many times the process repeats
# Create an empty group to store all the atoms from the identified molecules
group newgroup empty
group combined_combined_group empty
dump dumpnew newgroup custom 1000 group_output_100_30.txt id mol type x y z
dump dumpcombined combined_combined_group custom 1000 group_combined_output_100_30.txt id mol type x y z
label loop_step

    # Group atoms within the region
  group combined_group region region_combined
  group combined_combined_group union combined_combined_group combined_group

        # Assume 'oldgroup' is the group you want to work with

    # Step 1: Determine the number of atoms in 'oldgroup'
    variable numatoms equal count(combined_group)
    #variable num_atoms equal ${numatoms}


    
    # Step 2: Loop over all atoms in the old group
    #if numatoms==0, jump
    print "${numatoms}"
    if "${numatoms} == 0" then "jump in.control_3_small_23_200_8293 skip_newgroup"
    variable atomID atom gmask(combined_group)    #all atoms in that region
    #print "atomID: v_atomID"
    variable total_atoms equal count(all)
    variable atomi loop ${total_atoms}  #iterate for every atom
    label loop_start
      # Get the atom ID for the i-th atom in 'oldgroup'
      
     #variable vtest equal v_atomID[1]
      # Get the molecule ID for that atom
      variable vtest equal v_atomID[v_atomi] 
      
      if "${vtest}==0" then "jump in.control_3_small_23_200_8293 skip_group"
      # Add all atoms with this molecule ID to a temporary group
      variable molid equal mol[v_atomi]
      print "v ${atomi} ${vtest} ${molid}"
      group tempgroup molecule ${molid}
      variable newgroup_atoms equal count(tempgroup)
      #print "now tempgroup atoms ${newgroup_atoms}"
      # Union the temporary group with the new group
      group newgroup union newgroup tempgroup
      group tempgroup clear
        label skip_group
    next atomi
    jump in.control_3_small_23_200_8293 loop_start
    
    # Optional: Output the new group details
    print "New group 'newgroup' now contains all atoms from the molecules of the atoms in 'oldgroup'"

  label skip_newgroup
  # Optional: Apply operations to the combined group
  
fix fix_viscous newgroup viscous 10

  # Run for 1000 timesteps
  run ${step} every 1000 "print 'Selected new regions and updated groups.'"
  
  unfix fix_viscous
  group combined_group delete
  group combined_combined_group clear
  group newgroup clear

  
next n
